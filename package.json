{
  "name": "heart-to-heart-support",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/unit.test.mjs",
    "test:integration": "firebase emulators:exec --project demo-heart-to-heart --only auth,database,functions \"node --test tests/integration.test.mjs\"",
    "version:sync": "node scripts/version.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "firebase-tools": "15.32.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "@opentelemetry/core": "2.8.0"
  }
}
