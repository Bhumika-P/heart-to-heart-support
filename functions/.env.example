# Copy to .env.hearttoheart-14e56 locally; do not commit that file.
DATABASE_URL=https://hearttoheart-14e56-default-rtdb.firebaseio.com
# Destination for RSVP, contact, and retried email notifications.
MAIL_TO=hthlifecoaching@gmail.com
# Set this to the verified sending address configured with your SMTP provider.
MAIL_FROM=
# SMTP_URL is a Secret Manager secret, not a public environment variable.
# firebase functions:secrets:set SMTP_URL
# Value format: smtps://URL_ENCODED_USER:URL_ENCODED_PASSWORD@SMTP_HOST:465
